# Optional: enables the "Nara Guide" AI chat. Without it the Guide shows
# "unavailable" and everything else keeps working.
XAI_API_KEY=

# Optional: only needed if you later add a Postgres database (Neon/Supabase).
# DATABASE_URL=

# Frontend: URL of your deployed Cloudflare Worker (no trailing slash).
# Leave empty to run the offline demo mode.
VITE_API_URL=https://nara-api.YOUR-SUBDOMAIN.workers.dev
